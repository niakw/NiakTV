<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Use platform hostname and trust validation, without user-installed CAs,
         debugging trust overrides or third-party keys outside our control. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
